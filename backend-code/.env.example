# Copy to .env (never commit .env)
GITHUB_TOKEN=            # optional read-only token, lets Cypher read real public repositories without hitting GitHub's low limit
# CYPHER_MODEL=gemma4:e2b   # must start with gemma4
# CYPHER_LLM_MODE=live      # live = ask Gemma and record answers; replay = only use recorded answers (fast demos)
# CYPHER_NUM_CTX=4096
